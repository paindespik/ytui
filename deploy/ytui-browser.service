[Unit]
Description=ytui dedicated browser holding the YouTube session
# Its only job is to be a signed-in browser: YouTube renews the session's
# __Secure-1PSIDTS cookie for whoever holds it, and nothing else can. Never
# browse in this profile from elsewhere — a second holder steals the token and
# this copy goes stale.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Xvfb rather than --headless: measured, a headless load of youtube.com came
# back signed out and YouTube then cleared the .youtube.com cookies, destroying
# the session. A real (virtual) display behaves like an ordinary browser.
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" \
    /usr/bin/firefox --no-remote --profile %h/ytui-cookies/profile https://www.youtube.com/
# Only restart on crash, and never on a timer: every fresh load of youtube.com
# is a chance for YouTube to answer "signed out" and wipe the session, so the
# instance is meant to stay up for weeks.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
