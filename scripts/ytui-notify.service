[Unit]
Description=ytui desktop video notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path if your checkout lives elsewhere.
ExecStart=/usr/bin/python3 %h/ytui/scripts/ytui-notify.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
